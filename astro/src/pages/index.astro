---
import Base from '../layouts/Base.astro';
import ShowroomCanvas from '../scenes/showroom/ShowroomCanvas';
import Hero from '../components/Hero.astro';
import Meaning from '../components/Meaning.astro';
import Issue from '../components/Issue.astro';
---

<Base>
  <!-- The Digital Showroom: one persistent 3D space behind the whole page. -->
  <div class="showroom-bg" aria-hidden="true">
    <ShowroomCanvas client:load />
  </div>

  <main class="page">
    <Hero />
    <Meaning />
    <Issue />
  </main>
</Base>

<style is:global>
  .showroom-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .showroom-bg .showroom-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .page {
    position: relative;
    z-index: 1;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll<HTMLElement>('[data-reveal]');

  if (reduced) {
    els.forEach((el) => {
      el.style.opacity = '1';
      el.style.transform = 'none';
    });
  } else {
    gsap.registerPlugin(ScrollTrigger);
    els.forEach((el) => {
      const delay = Number(el.dataset.revealDelay ?? 0);
      gsap.fromTo(
        el,
        { autoAlpha: 0, y: 28 },
        {
          autoAlpha: 1,
          y: 0,
          duration: 1.1,
          delay,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 82%',
            once: true,
          },
        },
      );
    });
  }
</script>
