---
import '../styles/global.scss';

/**
 * 全ページ共通のベースレイアウト。
 * SEO まわり（title / description / canonical / OGP / Twitter カード / JSON-LD）と
 * アクセシビリティの土台（lang 属性・スキップリンク）をここで一括管理する。
 */
interface Props {
  /** ページタイトル。<title> と OGP に使う。 */
  title?: string;
  /** ページ説明文。meta description と OGP に使う。 */
  description?: string;
  /** OGP 画像のパス（サイトルートからの絶対パス）。 */
  ogImage?: string;
}

const {
  title = 'JUNKBRANDING｜HP/Web制作 — 眺めるWebサイトから、入り込むWebサイトへ。',
  description = '世界観まで伝わる、体験型Webサイトを制作します。普通のHPでは伝わらない空気感を、体験として伝えるWebサイト制作。',
  ogImage = '/ogp.png',
} = Astro.props;

// astro.config.mjs の `site` を基準に絶対 URL を組み立てる。
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

// 検索結果のリッチ化のための構造化データ（JSON-LD）。
// Organization / WebSite / WebPage / ProfessionalService を @graph で関連付ける。
const orgId = new URL('/#organization', Astro.site).href;
const websiteId = new URL('/#website', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'JUNKBRANDING',
      url: Astro.site?.href,
      email: 'hello@junkbranding.com',
      logo: {
        '@type': 'ImageObject',
        url: new URL('/favicon.svg', Astro.site).href,
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: Astro.site?.href,
      name: 'JUNKBRANDING',
      description,
      inLanguage: 'ja',
      publisher: { '@id': orgId },
    },
    {
      '@type': 'WebPage',
      '@id': canonicalUrl.href,
      url: canonicalUrl.href,
      name: title,
      description,
      inLanguage: 'ja',
      isPartOf: { '@id': websiteId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImageUrl.href,
      },
    },
    {
      '@type': 'ProfessionalService',
      '@id': new URL('/#service', Astro.site).href,
      name: 'JUNKBRANDING',
      url: Astro.site?.href,
      description,
      email: 'hello@junkbranding.com',
      areaServed: 'JP',
      parentOrganization: { '@id': orgId },
      // 提供サービスのカタログ（ServicesIndex のグループと対応）。
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'できること',
        itemListElement: [
          'Webサイト制作',
          'LP制作',
          'CMS構築・更新しやすいサイト制作',
          '体験型Web・演出サイト',
          '既存サイトの改善',
          'フロントエンド実装',
          'SEO・解析まわり',
          'Webデザイン・画像制作',
          '紙媒体・営業ツール',
          '小規模事業者向けサポート',
        ].map((name) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name },
        })),
      },
    },
  ],
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#24507e" />

    <!-- OGP: SNS・チャットアプリでの共有時の見え方。 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JUNKBRANDING" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter (X) カード。 -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />

    <!-- 構造化データ（JSON-LD）。 -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <!-- スキップリンク: キーボード / スクリーンリーダー利用者が
         固定 UI を飛ばして本文へ直行できるようにする。 -->
    <a class="skip-link" href="#main">本文へスキップ</a>
    <slot />
  </body>
</html>
