---
import Base from '../layouts/Base.astro';
import ShowroomCanvas from '../scenes/showroom/ShowroomCanvas';
import Hero from '../components/Hero.astro';
import Meaning from '../components/Meaning.astro';
import Issue from '../components/Issue.astro';
import ScatterGallery from '../components/ScatterGallery.astro';
---

<Base>
  <!-- The Digital Showroom: one persistent 3D space behind the whole page. -->
  <div class="showroom-bg" aria-hidden="true">
    <ShowroomCanvas client:load />
  </div>

  <a class="site-logo" href="/" aria-label="JUNK BRANDING トップへ">
    <span class="site-logo__main">JUNKBRANDING</span>
  </a>

  <main class="page">
    <Hero />
    <Meaning />
    <Issue />
    <ScatterGallery />
  </main>

  <button
    class="music-toggle"
    type="button"
    aria-label="音楽を再生"
    aria-pressed="false"
    title="Music"
    data-music-toggle
  >
    <span class="music-toggle__halo" aria-hidden="true"></span>
    <svg class="music-toggle__icon" viewBox="0 0 24 24" aria-hidden="true">
      <path
        class="music-toggle__speaker"
        d="M4.75 9.25h3.7l4.8-3.75v13l-4.8-3.75h-3.7z"
        fill="none"
        stroke="currentColor"
        stroke-linejoin="round"
        stroke-width="1.7"
      />
      <path
        class="music-toggle__wave music-toggle__wave--inner"
        d="M16 9.1c.82.78 1.23 1.74 1.23 2.9s-.41 2.12-1.23 2.9"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-width="1.7"
      />
      <path
        class="music-toggle__wave music-toggle__wave--outer"
        d="M18.45 6.9c1.36 1.37 2.04 3.06 2.04 5.1s-.68 3.73-2.04 5.1"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-width="1.7"
      />
      <path
        class="music-toggle__slash"
        d="M5.2 4.8 19 19.2"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-width="1.8"
      />
    </svg>
  </button>

  <audio data-music-loop src="/noctiluca_night_sea_loop.wav" preload="none" loop></audio>
</Base>

<style is:global>
  .showroom-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(
        circle at 50% 46%,
        rgba(244, 248, 255, 0.26) 0%,
        rgba(124, 148, 178, 0.14) 28%,
        rgba(18, 21, 28, 0.82) 62%,
        #07070b 100%
      );
  }

  .showroom-bg .showroom-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .page {
    position: relative;
    z-index: 1;
    perspective: 900px;
    isolation: isolate;
    --blend-overlap: clamp(24rem, 100vh, 68rem);
    /* Extra breathing room between sections so the gravity transition
       has a long, visible scroll window of its own. */
    --section-gap: clamp(28rem, 130vh, 72rem);
    --gravity-progress: 0;
    --gravity-blend: 0;
    --gravity-pull-y: 0px;
    --gravity-stretch-y: 1;
    --gravity-band-height: 80px;
    --gravity-tension: 0;
    --gravity-elastic-return: 0;
    --gravity-boundary-scale-y: 1;
    --gravity-overlay: 0;
    --hero-boundary-shift: 0px;
    --meaning-boundary-shift: 0px;
    --meaning-rise: 3.5rem;
  }

  .site-logo {
    position: fixed;
    top: max(1.1rem, env(safe-area-inset-top));
    left: max(1.4rem, env(safe-area-inset-left));
    z-index: 20;
    display: flex;
    align-items: baseline;
    gap: 0.55em;
    font-family: var(--font-serif);
    text-decoration: none;
    color: var(--ink);
    mix-blend-mode: difference;
    transition: opacity 0.28s ease;
  }

  .site-logo:hover {
    opacity: 0.72;
  }

  .site-logo:focus-visible {
    outline: 2px solid rgba(210, 232, 255, 0.76);
    outline-offset: 6px;
  }

  .site-logo__main {
    font-size: 1.18rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    line-height: 1;
  }

  .site-logo__sub {
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.42em;
    line-height: 1;
    color: var(--warm);
    opacity: 0.85;
  }

  .music-toggle {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 20;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    padding: 0;
    border: 1px solid rgba(225, 238, 255, 0.18);
    border-radius: 999px;
    color: rgba(235, 242, 255, 0.78);
    background:
      radial-gradient(circle at 50% 35%, rgba(235, 244, 255, 0.18), transparent 62%),
      rgba(7, 7, 11, 0.54);
    box-shadow:
      0 1rem 2.4rem rgba(0, 0, 0, 0.34),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(18px) saturate(130%);
    -webkit-backdrop-filter: blur(18px) saturate(130%);
    cursor: pointer;
    isolation: isolate;
    transition:
      color 0.28s ease,
      border-color 0.28s ease,
      background 0.28s ease,
      transform 0.28s ease,
      box-shadow 0.28s ease;
  }

  .music-toggle:hover {
    transform: translateY(-2px);
    border-color: rgba(220, 236, 255, 0.34);
    color: #eef6ff;
  }

  .music-toggle:focus-visible {
    outline: 2px solid rgba(210, 232, 255, 0.76);
    outline-offset: 4px;
  }

  .music-toggle.is-on {
    color: #f4f8ff;
    border-color: rgba(218, 236, 255, 0.52);
    background:
      radial-gradient(circle at 50% 45%, rgba(232, 242, 255, 0.34), rgba(232, 242, 255, 0.08) 56%, transparent 72%),
      rgba(12, 14, 18, 0.62);
    box-shadow:
      0 1rem 2.8rem rgba(0, 0, 0, 0.36),
      0 0 2rem rgba(222, 238, 255, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .music-toggle__halo {
    position: absolute;
    inset: 0.42rem;
    z-index: -1;
    border-radius: inherit;
    background: rgba(230, 240, 255, 0.18);
    opacity: 0;
    transform: scale(0.78);
    transition:
      opacity 0.28s ease,
      transform 0.28s ease;
  }

  .music-toggle.is-on .music-toggle__halo {
    opacity: 1;
    transform: scale(1);
    animation: musicPulse 2.4s ease-in-out infinite;
  }

  .music-toggle__icon {
    width: 1.35rem;
    height: 1.35rem;
    filter: drop-shadow(0 0 0.65rem rgba(225, 239, 255, 0.22));
  }

  .music-toggle__slash {
    opacity: 1;
    transform-origin: center;
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
  }

  .music-toggle__wave {
    opacity: 0.22;
    transform-origin: 12px 12px;
    transition:
      opacity 0.24s ease,
      transform 0.24s ease;
  }

  .music-toggle.is-on .music-toggle__slash {
    opacity: 0;
    transform: scaleX(0.32) rotate(-8deg);
  }

  .music-toggle.is-on .music-toggle__wave {
    opacity: 1;
  }

  .music-toggle.is-on .music-toggle__wave--outer {
    animation: musicWave 1.8s ease-in-out infinite;
  }

  @keyframes musicPulse {
    0%,
    100% {
      opacity: 0.58;
      transform: scale(0.92);
    }

    50% {
      opacity: 1;
      transform: scale(1.12);
    }
  }

  @keyframes musicWave {
    0%,
    100% {
      transform: scale(0.96);
    }

    50% {
      transform: scale(1.08);
    }
  }

  .page > section {
    transform-style: preserve-3d;
  }

  [data-transition-from],
  [data-transition-to] {
    position: relative;
    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }

  .meaning__inner,
  .meaning__label,
  .meaning__lead,
  .meaning__body,
  .issue__inner,
  .issue__label,
  .issue__lead,
  .issue__body {
    will-change: transform, opacity, filter, text-shadow;
  }

  [data-transition-from] {
    z-index: 2;
    /* Keep the section's own content above the bottom fade zone of the mask,
       otherwise it renders half-transparent (= looks dark). */
    padding-bottom: var(--blend-overlap);
    margin-bottom: calc(var(--blend-overlap) * -1);
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 calc(100% - var(--blend-overlap) * 1.05),
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 calc(100% - var(--blend-overlap) * 1.05),
      transparent 100%
    );
  }

  [data-transition-to] {
    z-index: 3;
    padding-top: calc(var(--blend-overlap) + var(--section-gap));
    transform: translate3d(0, var(--meaning-rise), 0);
    opacity: 1;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 calc(var(--blend-overlap) * 1.08),
      #000 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 calc(var(--blend-overlap) * 1.08),
      #000 100%
    );
  }

  [data-transition-from][data-transition-to] {
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 calc(var(--blend-overlap) * 0.82),
      #000 calc(100% - var(--blend-overlap) * 0.82),
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 calc(var(--blend-overlap) * 0.82),
      #000 calc(100% - var(--blend-overlap) * 0.82),
      transparent 100%
    );
  }

  .meaning[data-transition-from],
  .meaning[data-transition-to],
  .issue[data-transition-from],
  .issue[data-transition-to] {
    -webkit-mask-image: none;
    mask-image: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-transition-from],
    [data-transition-to] {
      transform: none;
      opacity: 1;
      filter: none;
      -webkit-mask-image: none;
      mask-image: none;
    }

    [data-transition-from] {
      margin-bottom: 0;
      padding-bottom: 0;
    }

    [data-transition-to] {
      padding-top: 0;
    }

    .music-toggle.is-on .music-toggle__halo,
    .music-toggle.is-on .music-toggle__wave--outer {
      animation: none;
    }

  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const page = document.querySelector<HTMLElement>('.page');
  const musicToggle = document.querySelector<HTMLButtonElement>('[data-music-toggle]');
  const musicLoop = document.querySelector<HTMLAudioElement>('[data-music-loop]');
  const scatterGalleries = document.querySelectorAll<HTMLElement>('[data-scatter-gallery]');

  const clamp01 = (value: number) => Math.min(Math.max(value, 0), 1);
  const smoothstep = (edge0: number, edge1: number, value: number) => {
    const t = clamp01((value - edge0) / (edge1 - edge0));
    return t * t * (3 - 2 * t);
  };

  const scatterPanelsOf = (gallery: HTMLElement) =>
    Array.from(gallery.querySelectorAll<HTMLElement>('[data-scatter-panel]'));

  const initGlitchPanel = (canvas: HTMLCanvasElement, allowHover: boolean) => {
    const gl = canvas.getContext('webgl', {
      antialias: false,
      alpha: false,
      premultipliedAlpha: false,
    });
    const src = canvas.dataset.src;
    if (!gl || !src) return;

    const vertex = `
      attribute vec2 aPosition;
      varying vec2 vUv;

      void main() {
        vUv = aPosition * 0.5 + 0.5;
        gl_Position = vec4(aPosition, 0.0, 1.0);
      }
    `;
    const fragment = `
      precision highp float;

      uniform sampler2D uImage;
      uniform vec2 uImageSize;
      uniform vec2 uCanvasSize;
      uniform float uHover;
      uniform float uTime;

      varying vec2 vUv;

      float hash(vec2 p) {
        return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
      }

      vec2 coverUv(vec2 uv) {
        float canvasAspect = uCanvasSize.x / max(uCanvasSize.y, 0.0001);
        float imageAspect = uImageSize.x / max(uImageSize.y, 0.0001);
        vec2 scale = vec2(1.0);

        if (imageAspect > canvasAspect) {
          scale.x = canvasAspect / imageAspect;
        } else {
          scale.y = imageAspect / canvasAspect;
        }

        return clamp((uv - 0.5) * scale + 0.5, vec2(0.001), vec2(0.999));
      }

      void main() {
        vec2 uv = coverUv(vUv);
        float row = floor(vUv.y * 38.0);
        float timeStep = floor(uTime * 18.0);
        float stripeNoise = hash(vec2(row, timeStep));
        float stripe = step(0.58 - uHover * 0.46, stripeNoise);
        float thinBand = 1.0 - smoothstep(0.0, 0.04, abs(fract(vUv.y * 38.0) - 0.5));
        float slice = (hash(vec2(row * 4.7, timeStep + 9.0)) - 0.5) * stripe * thinBand * uHover * 0.6;
        float jitter = (hash(vec2(floor(vUv.y * 118.0), timeStep * 2.0)) - 0.5) * uHover * 0.06;
        vec2 shifted = uv + vec2(slice + jitter, 0.0);

        float chroma = uHover * (0.035 + stripe * 0.09);
        float verticalChroma = uHover * stripe * thinBand * 0.03;
        vec2 redUv = clamp(shifted + vec2(chroma, verticalChroma), vec2(0.001), vec2(0.999));
        vec2 greenUv = clamp(shifted, vec2(0.001), vec2(0.999));
        vec2 blueUv = clamp(shifted - vec2(chroma, verticalChroma), vec2(0.001), vec2(0.999));

        vec3 color;
        color.r = texture2D(uImage, redUv).r;
        color.g = texture2D(uImage, greenUv).g;
        color.b = texture2D(uImage, blueUv).b;

        float grain = hash(vUv * uCanvasSize + uTime * 61.0) - 0.5;
        float scan = sin(vUv.y * uCanvasSize.y * 1.35) * 0.5 + 0.5;
        color += grain * uHover * 0.6;
        color += vec3(0.1, 0.36, 1.0) * stripe * thinBand * uHover * 0.8;
        color += vec3(1.0, 0.12, 0.42) * stripe * uHover * 0.22;
        color *= 1.0 + uHover * 0.6;
        color *= mix(1.0, 0.74 + scan * 0.9, uHover * 0.72);

        gl_FragColor = vec4(color, 1.0);
      }
    `;

    const compile = (type: number, source: string) => {
      const shader = gl.createShader(type);
      if (!shader) return null;
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
        console.warn(gl.getShaderInfoLog(shader));
        gl.deleteShader(shader);
        return null;
      }
      return shader;
    };

    const vertexShader = compile(gl.VERTEX_SHADER, vertex);
    const fragmentShader = compile(gl.FRAGMENT_SHADER, fragment);
    if (!vertexShader || !fragmentShader) return;

    const program = gl.createProgram();
    if (!program) return;
    gl.attachShader(program, vertexShader);
    gl.attachShader(program, fragmentShader);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      console.warn(gl.getProgramInfoLog(program));
      return;
    }
    gl.useProgram(program);

    const buffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]),
      gl.STATIC_DRAW,
    );

    const position = gl.getAttribLocation(program, 'aPosition');
    gl.enableVertexAttribArray(position);
    gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);

    const uniforms = {
      image: gl.getUniformLocation(program, 'uImage'),
      imageSize: gl.getUniformLocation(program, 'uImageSize'),
      canvasSize: gl.getUniformLocation(program, 'uCanvasSize'),
      hover: gl.getUniformLocation(program, 'uHover'),
      time: gl.getUniformLocation(program, 'uTime'),
    };
    const texture = gl.createTexture();
    gl.activeTexture(gl.TEXTURE0);
    gl.bindTexture(gl.TEXTURE_2D, texture);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    gl.uniform1i(uniforms.image, 0);
    gl.uniform2f(uniforms.canvasSize, canvas.width, canvas.height);

    let targetHover = 0;
    let hover = 0;
    let raf = 0;
    let imageReady = false;
    const image = new Image();

    const render = (time: number) => {
      hover += (targetHover - hover) * 0.14;
      if (!imageReady) {
        raf = requestAnimationFrame(render);
        return;
      }

      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform1f(uniforms.hover, hover);
      gl.uniform1f(uniforms.time, time * 0.001);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

      if (Math.abs(targetHover - hover) > 0.001 || targetHover > 0) {
        raf = requestAnimationFrame(render);
      } else {
        raf = 0;
      }
    };

    const requestRender = () => {
      if (!raf) raf = requestAnimationFrame(render);
    };

    image.onload = () => {
      imageReady = true;
      gl.bindTexture(gl.TEXTURE_2D, texture);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, image);
      gl.uniform2f(uniforms.imageSize, image.naturalWidth, image.naturalHeight);
      requestRender();
    };
    image.src = src;

    if (allowHover) {
      canvas.addEventListener('pointerenter', () => {
        targetHover = 1;
        requestRender();
      });
      canvas.addEventListener('pointerleave', () => {
        targetHover = 0;
        requestRender();
      });
    }
  };

  const settleScatterGallery = (gallery: HTMLElement) => {
    scatterPanelsOf(gallery).forEach((panel) => {
      panel.style.opacity = '1';
      panel.style.transform = `
        translate3d(calc(-50% + ${panel.dataset.x}), calc(-50% + ${panel.dataset.y}), 0)
        rotate(${panel.dataset.rotate})
        scale(${panel.dataset.scale})
      `;
      panel.style.filter = 'none';
    });
  };

  document
    .querySelectorAll<HTMLCanvasElement>('[data-glitch-panel]')
    .forEach((canvas) => initGlitchPanel(canvas, !reduced));

  if (musicToggle && musicLoop) {
    let fadeFrame = 0;
    const fadeVolume = (target: number, onDone?: () => void) => {
      cancelAnimationFrame(fadeFrame);

      const start = musicLoop.volume;
      const startedAt = performance.now();
      const duration = 420;
      const tick = (now: number) => {
        const progress = clamp01((now - startedAt) / duration);
        musicLoop.volume = start + (target - start) * smoothstep(0, 1, progress);

        if (progress < 1) {
          fadeFrame = requestAnimationFrame(tick);
          return;
        }

        onDone?.();
      };

      fadeFrame = requestAnimationFrame(tick);
    };

    const setMusicState = (isOn: boolean) => {
      musicToggle.classList.toggle('is-on', isOn);
      musicToggle.setAttribute('aria-pressed', String(isOn));
      musicToggle.setAttribute('aria-label', isOn ? '音楽を停止' : '音楽を再生');
    };

    musicLoop.volume = 0;
    setMusicState(false);

    musicToggle.addEventListener('click', () => {
      const shouldPlay = musicLoop.paused;

      if (shouldPlay) {
        setMusicState(true);
        fadeVolume(0.42);
        void musicLoop.play().catch(() => {
          setMusicState(false);
          fadeVolume(0);
        });
        return;
      }

      setMusicState(false);
      fadeVolume(0, () => musicLoop.pause());
    });
  }

  if (reduced) {
    els.forEach((el) => {
      el.style.opacity = '1';
      el.style.transform = 'none';
    });
    scatterGalleries.forEach(settleScatterGallery);
  } else {
    gsap.registerPlugin(ScrollTrigger);
    els.forEach((el) => {
      if (el.closest('[data-transition-to]')) return;

      const delay = Number(el.dataset.revealDelay ?? 0);
      gsap.fromTo(
        el,
        { autoAlpha: 0, y: 28 },
        {
          autoAlpha: 1,
          y: 0,
          duration: 1.1,
          delay,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 82%',
            once: true,
          },
        },
      );
    });

    scatterGalleries.forEach((gallery) => {
      const panels = scatterPanelsOf(gallery);
      if (!panels.length) return;

      gsap.set(panels, {
        xPercent: -50,
        yPercent: -50,
        x: 0,
        y: 0,
        rotation: 0,
        scale: (index) => (index === 0 ? 0.72 : 0.58),
        autoAlpha: (index) => (index === 0 ? 0 : 0),
        filter: 'blur(10px)',
      });

      const scatterTimeline = gsap.timeline({
        scrollTrigger: {
          trigger: gallery,
          start: 'top 68%',
          end: 'bottom 34%',
          scrub: true,
          invalidateOnRefresh: true,
        },
      });

      scatterTimeline
        .to(panels[0], {
          autoAlpha: 1,
          scale: 0.96,
          filter: 'blur(0px)',
          duration: 0.22,
          ease: 'power2.out',
        })
        .to(panels, {
          x: (_index, target) => (target as HTMLElement).dataset.x ?? '0vw',
          y: (_index, target) => (target as HTMLElement).dataset.y ?? '0vh',
          rotation: (_index, target) => (target as HTMLElement).dataset.rotate ?? '0deg',
          scale: (_index, target) => Number((target as HTMLElement).dataset.scale ?? 1),
          autoAlpha: 1,
          filter: 'blur(0px)',
          duration: 0.78,
          stagger: { amount: 0.18, from: 'center' },
          ease: 'none',
        }, 0.22);
    });

    if (page) {
      // Generic boundary system: every adjacent pair of `.page > section`
      // gets one gravity transition, anchored on the actual content positions
      // (not section offsetTop, which is skewed by the overlap margins).
      const sections = Array.from(page.querySelectorAll<HTMLElement>(':scope > section'));
      const innerOf = (section: HTMLElement) =>
        section.querySelector<HTMLElement>(':scope > [class*="__inner"]');
      const scrimOf = (section: HTMLElement) =>
        section.querySelector<HTMLElement>(':scope > [class*="__scrim"]');

      sections.forEach((fromSection, index) => {
        const toSection = sections[index + 1];
        if (!toSection) return;

        const fromInner = innerOf(fromSection);
        const toInner = innerOf(toSection);
        if (!fromInner || !toInner) return;

        const fromScrim = scrimOf(fromSection);
        const fromText = Array.from(fromInner.children).filter(
          (child): child is HTMLElement => child instanceof HTMLElement,
        );
        const toText = Array.from(toInner.children).filter(
          (child): child is HTMLElement => child instanceof HTMLElement,
        );

        ScrollTrigger.create({
          trigger: fromSection,
          // Starts once the outgoing content is leaving the upper half of the
          // viewport — never while it is still centred on screen.
          start: () =>
            fromSection.offsetTop + fromInner.offsetTop + fromInner.offsetHeight - window.innerHeight * 0.55,
          endTrigger: toSection,
          // Ends right before the incoming content enters the viewport,
          // so the effect is fully over by the time the next section appears.
          end: () => toSection.offsetTop + toInner.offsetTop - window.innerHeight,
          scrub: true,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            const progress = self.progress;
            const viewport = window.innerHeight;
            const blendAmount = Math.sin(progress * Math.PI);
            const handoff = smoothstep(0.24, 0.78, progress);
            const returnPhase = smoothstep(0.58, 1, progress);
            const elasticReturn = returnPhase * Math.sin(returnPhase * Math.PI) * viewport * 0.024;
            const pullY = blendAmount * viewport * 0.4 - elasticReturn;
            const stretchY = 1 + blendAmount * 3;
            const bandHeight = viewport * (0.32 + blendAmount * 0.72);
            const tension = Math.pow(blendAmount, 1.6);
            const boundaryScaleY = stretchY + tension * 0.46;
            const glitchKick = tension * Math.sin(progress * Math.PI * 9);
            const chromaShadow = [
              `${(-7 * tension).toFixed(2)}px ${(2 * tension).toFixed(2)}px 0 rgba(238, 246, 255, ${Math.min(0.3, tension * 0.3).toFixed(3)})`,
              `${(8 * tension).toFixed(2)}px ${(-2 * tension).toFixed(2)}px 0 rgba(64, 104, 255, ${Math.min(0.24, tension * 0.24).toFixed(3)})`,
              `0 ${(18 * tension).toFixed(2)}px ${(34 * tension).toFixed(2)}px rgba(232, 240, 255, ${Math.min(0.28, tension * 0.28).toFixed(3)})`,
              '0 1px 40px rgba(6, 7, 11, 0.6)',
            ].join(', ');

            page.style.setProperty('--gravity-progress', progress.toFixed(4));
            page.style.setProperty('--gravity-blend', blendAmount.toFixed(4));
            page.style.setProperty('--gravity-pull-y', `${pullY.toFixed(2)}px`);
            page.style.setProperty('--gravity-stretch-y', stretchY.toFixed(4));
            page.style.setProperty('--gravity-band-height', `${bandHeight.toFixed(2)}px`);
            page.style.setProperty('--gravity-tension', tension.toFixed(4));
            page.style.setProperty('--gravity-elastic-return', elasticReturn.toFixed(4));
            page.style.setProperty('--gravity-boundary-scale-y', boundaryScaleY.toFixed(4));
            page.style.setProperty('--gravity-overlay', Math.min(0.92, 0.18 + tension * 0.72).toFixed(4));
            page.style.setProperty('--hero-boundary-shift', `${pullY.toFixed(2)}px`);
            page.style.setProperty('--meaning-boundary-shift', `${(-pullY).toFixed(2)}px`);
            page.style.setProperty('--meaning-rise', `${((1 - handoff) * 3.5).toFixed(3)}rem`);

            gsap.set(fromSection, {
              y: -progress * 26 + pullY * 0.08,
              scaleY: 1 + tension * 0.06,
              transformOrigin: '50% 72%',
            });
            gsap.set(toSection, {
              y: -pullY * 0.16,
              autoAlpha: 0.9 + handoff * 0.1,
              scaleY: 1 + tension * 0.06,
              transformOrigin: '50% 22%',
            });
            if (fromScrim) {
              gsap.set(fromScrim, {
                y: pullY * 0.5,
                scaleY: 1 + blendAmount * 0.8,
                autoAlpha: 0.86 - progress * 0.3,
                transformOrigin: 'bottom center',
              });
            }
            gsap.set(fromInner, {
              y: -progress * 30 + pullY * 0.3,
              scaleY: 1 + tension * 0.34,
              scaleX: 1 - tension * 0.035,
              skewY: -blendAmount * 0.28 + glitchKick * 0.16,
              autoAlpha: 1 - progress * 0.3,
              filter: `blur(${(tension * 0.62).toFixed(2)}px) saturate(${(1 + tension * 0.42).toFixed(3)})`,
              transformOrigin: '50% 64%',
            });
            gsap.set(toInner, {
              y: (1 - handoff) * 42 - pullY * 0.16,
              scaleY: 1 + tension * 0.16,
              scaleX: 1 - tension * 0.02,
              skewY: blendAmount * 0.2 * (progress < 0.5 ? 1 : -1),
              autoAlpha: 0.86 + handoff * 0.14,
              filter: `blur(${(tension * 0.26).toFixed(2)}px) saturate(${(1 + tension * 0.22).toFixed(3)})`,
              transformOrigin: '50% 30%',
            });
            gsap.set(fromText, {
              y: pullY * 0.08,
              scaleY: 1 + tension * 0.24,
              x: glitchKick * 3,
              textShadow: chromaShadow,
            });
            gsap.set(toText, {
              y: -pullY * 0.06,
              scaleY: 1 + tension * 0.16,
              x: glitchKick * -2.4,
              textShadow: chromaShadow,
            });
          },
        });
      });
    }
  }
</script>
