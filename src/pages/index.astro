---
import Base from '../layouts/Base.astro';
import ShowroomCanvas from '../scenes/showroom/ShowroomCanvas';
import Hero from '../components/Hero.astro';
import Meaning from '../components/Meaning.astro';
---

<Base>
  <!-- The Digital Showroom: one persistent 3D space behind the whole page. -->
  <div class="showroom-bg" aria-hidden="true">
    <ShowroomCanvas client:load />
  </div>

  <svg class="gravity-filter-defs" aria-hidden="true" focusable="false">
    <filter id="gravity-section-displace">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.012 0.085"
        numOctaves="2"
        seed="8"
        result="gravityNoise"
      />
      <feDisplacementMap
        in="SourceGraphic"
        in2="gravityNoise"
        scale="0"
        xChannelSelector="R"
        yChannelSelector="B"
      />
    </filter>
  </svg>

  <main class="page">
    <Hero />
    <Meaning />
  </main>
</Base>

<style is:global>
  .showroom-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .showroom-bg .showroom-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gravity-filter-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .page {
    position: relative;
    z-index: 1;
    perspective: 900px;
    isolation: isolate;
    --blend-overlap: clamp(8rem, 34vh, 22rem);
  }

  .page > section {
    transform-style: preserve-3d;
  }

  [data-transition-from],
  [data-transition-to] {
    position: relative;
    transform-origin: 50% 50%;
    will-change: clip-path, transform, opacity, filter;
    filter: url("#gravity-section-displace");
  }

  [data-transition-from] {
    z-index: 2;
    margin-bottom: calc(var(--blend-overlap) * -1);
    clip-path: inset(0 0 0% 0);
  }

  [data-transition-to] {
    z-index: 3;
    padding-top: var(--blend-overlap);
    clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0 100%);
    transform: translate3d(0, 3.5rem, 0);
    opacity: 0.88;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-transition-from],
    [data-transition-to] {
      clip-path: none;
      transform: none;
      opacity: 1;
      filter: none;
    }

    [data-transition-from] {
      margin-bottom: 0;
    }

    [data-transition-to] {
      padding-top: 0;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const hero = document.querySelector<HTMLElement>('[data-transition-from="hero"]');
  const meaning = document.querySelector<HTMLElement>('[data-transition-to="meaning"]');

  if (reduced) {
    els.forEach((el) => {
      el.style.opacity = '1';
      el.style.transform = 'none';
    });
  } else {
    gsap.registerPlugin(ScrollTrigger);
    els.forEach((el) => {
      if (el.closest('[data-transition-to]')) return;

      const delay = Number(el.dataset.revealDelay ?? 0);
      gsap.fromTo(
        el,
        { autoAlpha: 0, y: 28 },
        {
          autoAlpha: 1,
          y: 0,
          duration: 1.1,
          delay,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 82%',
            once: true,
          },
        },
      );
    });

    if (hero && meaning) {
      const heroScrim = hero.querySelector<HTMLElement>('.hero__scrim');
      const heroContent = hero.querySelector<HTMLElement>('.hero__inner');
      const meaningContent = meaning.querySelector<HTMLElement>('.meaning__inner');
      const displacement = document.querySelector<SVGFEDisplacementMapElement>(
        '#gravity-section-displace feDisplacementMap',
      );
      const heroOpen = 'polygon(0% 0%, 100% 0%, 100% 100%, 82% 100%, 68% 100%, 56% 100%, 50% 100%, 44% 100%, 32% 100%, 18% 100%, 0% 100%)';
      const heroPulled = 'polygon(0% 0%, 100% 0%, 100% 86%, 82% 84%, 68% 93%, 56% 74%, 50% 100%, 44% 74%, 32% 93%, 18% 84%, 0% 86%)';
      const heroRelease = 'polygon(0% 0%, 100% 0%, 100% 48%, 82% 50%, 68% 46%, 56% 56%, 50% 62%, 44% 56%, 32% 46%, 18% 50%, 0% 48%)';
      const meaningHidden = 'polygon(0% 100%, 18% 100%, 32% 100%, 44% 100%, 50% 100%, 56% 100%, 68% 100%, 82% 100%, 100% 100%, 100% 100%, 0% 100%)';
      const meaningPulled = 'polygon(0% 24%, 18% 20%, 32% 8%, 44% 30%, 50% 0%, 56% 30%, 68% 8%, 82% 20%, 100% 24%, 100% 100%, 0% 100%)';
      const meaningOpen = 'polygon(0% 0%, 18% 0%, 32% 0%, 44% 0%, 50% 0%, 56% 0%, 68% 0%, 82% 0%, 100% 0%, 100% 100%, 0% 100%)';

      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });

      tl.fromTo(
        hero,
        { clipPath: heroOpen, y: 0, scaleY: 1 },
        { clipPath: heroPulled, y: -8, scaleY: 1.035, duration: 0.5 },
        0,
      )
        .to(hero, { clipPath: heroRelease, y: -34, scaleY: 0.985, duration: 0.5 }, 0.5)
        .to(displacement, { attr: { scale: 42 }, duration: 0.5 }, 0)
        .to(displacement, { attr: { scale: 0 }, duration: 0.5 }, 0.5)
        .fromTo(
          meaning,
          { clipPath: meaningHidden, y: 56, scaleY: 0.96, autoAlpha: 0.88 },
          { clipPath: meaningPulled, y: 10, scaleY: 1.045, autoAlpha: 1, duration: 0.5 },
          0,
        )
        .to(meaning, { clipPath: meaningOpen, y: 0, scaleY: 1, duration: 0.5 }, 0.5)
        .to(heroScrim, { scaleY: 1.26, transformOrigin: '50% 78%', autoAlpha: 0.86, duration: 0.5 }, 0.12)
        .to(heroScrim, { scaleY: 0.82, autoAlpha: 0.34, duration: 0.42 }, 0.58)
        .fromTo(
          heroContent,
          { y: 0, scaleY: 1, skewY: 0, autoAlpha: 1 },
          { y: -34, scaleY: 1.08, skewY: -1.2, autoAlpha: 0.72, duration: 0.5 },
          0,
        )
        .to(heroContent, { y: -64, scaleY: 0.96, skewY: 0, autoAlpha: 0.22, duration: 0.5 }, 0.5)
        .fromTo(
          meaningContent,
          { y: 42, scaleY: 0.92, skewY: 1.1, autoAlpha: 0.58 },
          { y: -8, scaleY: 1.08, skewY: -0.7, autoAlpha: 1, duration: 0.5 },
          0.28,
        )
        .to(meaningContent, { y: 0, scaleY: 1, skewY: 0, duration: 0.36 }, 0.64);
    }
  }
</script>
