---
import Base from '../layouts/Base.astro';
import ShowroomCanvas from '../scenes/showroom/ShowroomCanvas';
import ControlExperience from '../components/ControlExperience';
import SiteLogo from '../components/SiteLogo.astro';
import MusicDock from '../components/MusicDock.astro';
import Hero from '../components/Hero.astro';
import Meaning from '../components/Meaning.astro';
import Issue from '../components/Issue.astro';
import ScatterGallery from '../components/ScatterGallery.astro';
import ServicesIndex from '../components/ServicesIndex.astro';
import FinalCta from '../components/FinalCta.astro';
---

<Base>
  <ControlExperience client:load />

  <!-- デジタルショールーム: ページ全体の背後に常駐する 1 つの 3D 空間。 -->
  <div class="showroom-bg" aria-hidden="true">
    <ShowroomCanvas client:load />
  </div>

  <!-- バナーランドマーク: スクリーンリーダーのランドマークナビゲーション用。 -->
  <header>
    <SiteLogo />
  </header>

  <div id="funky-reveal" class="funky-reveal-overlay" data-funky-reveal aria-hidden="true">
    <section class="funky-reveal" data-funky-reveal-stage aria-hidden="true">
      <div class="funky-reveal__image" data-funky-reveal-image aria-hidden="true">
        <img src="/hp.png" alt="" loading="eager" decoding="async" />
      </div>
      <div class="funky-reveal__dissolve-grid" data-funky-dissolve-grid></div>
    </section>
  </div>

  <main id="main" class="page" tabindex="-1">
    <Hero />
    <Meaning />
    <Issue />
    <ScatterGallery />
    <ServicesIndex />
    <FinalCta />
  </main>

  <MusicDock />
</Base>

<!--
  ページの接着スタイルのみを置く: 固定の WebGL 背景、共有レイアウト変数を持つ
  .page のスタッキングコンテキスト、そして重力遷移が依存するセクション間の
  マスク / 遷移システム。コンポーネント固有のスタイルは各コンポーネントに、
  動作のロジックは src/scripts/* にある。
-->
<style is:global>
  /* 展示モーダル: キューブ遷移の直後に中央へせり上がるオーバーレイ。 */
  .exhibit-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    padding: var(--gutter);
    background: radial-gradient(
      circle at 50% 50%,
      rgba(6, 7, 11, 0.74) 0%,
      rgba(6, 7, 11, 0.88) 70%,
      rgba(6, 7, 11, 0.94) 100%
    );
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    animation: exhibit-modal-fade 0.32s ease both;
  }

  .exhibit-modal {
    position: relative;
    width: min(56rem, 92vw);
    max-height: 88vh;
    overflow: hidden;
    border-radius: 14px;
    background: rgba(13, 18, 28, 0.92);
    border: 1px solid rgba(174, 189, 210, 0.18);
    box-shadow: 0 30px 90px rgba(6, 7, 11, 0.6);
    transform-origin: 50% 50%;
    /* 中央で薄い板になったキューブを引き継ぐので、回転はせず
       わずかな拡大とフェードだけで滑らかにつなぐ。 */
    animation: exhibit-modal-pop 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .exhibit-modal__media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #06070b;
  }

  .exhibit-modal__media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .exhibit-modal__body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.4rem 1.3rem;
  }

  .exhibit-modal__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 2.4vw, 1.5rem);
    letter-spacing: 0.04em;
    color: #fff;
  }

  .exhibit-modal__visit {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.4rem;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #06070b;
    background: var(--warm, #f4dcbb);
    border-radius: 999px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .exhibit-modal__visit:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  .exhibit-modal__close {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    z-index: 2;
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    line-height: 1;
    color: #fff;
    background: rgba(6, 7, 11, 0.55);
    border: 1px solid rgba(174, 189, 210, 0.24);
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .exhibit-modal__close:hover {
    background: rgba(6, 7, 11, 0.8);
    transform: scale(1.05);
  }

  @keyframes exhibit-modal-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes exhibit-modal-pop {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exhibit-modal-backdrop,
    .exhibit-modal {
      animation: none;
    }
  }

  .funky-reveal-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 70;
    overflow: hidden;
    background: transparent;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .funky-reveal-overlay.is-active {
    visibility: visible;
  }

  .funky-reveal {
    position: absolute;
    inset: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background: transparent;
    transform: translate3d(110vw, 0, 0);
    will-change: transform;
  }

  .funky-reveal__image {
    position: absolute;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 10;
    overflow: hidden;
    background: transparent;
    opacity: 0;
    visibility: hidden;
    clip-path: inset(0 0 0 var(--funky-image-mask-left, 100%));
    -webkit-clip-path: inset(0 0 0 var(--funky-image-mask-left, 100%));
  }

  .funky-reveal__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .funky-reveal__dissolve-grid {
    position: absolute;
    inset: 0;
    z-index: 100;
    contain: layout paint style;
    pointer-events: none;
  }

  .funky-reveal__dissolve-cell {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    visibility: hidden;
    background: transparent;
    contain: layout paint style;
  }

  .funky-reveal__dissolve-cell::before {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: 50%;
    background: linear-gradient(135deg, #021b69 0%, #0a73d9 38%, #18c8ff 72%, #d9fbff 100%);
    background-size: 100vw 100vh;
    background-position: inherit;
  }

  .funky-reveal__dissolve-cell.is-square::before {
    border-radius: 0;
  }

  .funky-reveal__dissolve-cell.is-core::before {
    inset: 0;
    border-radius: 0;
  }

  .showroom-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(
        circle at 50% 72%,
        rgba(255, 209, 138, 0.42) 0%,
        rgba(255, 151, 111, 0.22) 24%,
        rgba(142, 184, 218, 0.42) 54%,
        rgba(36, 80, 126, 0.96) 100%
      ),
      linear-gradient(
        180deg,
        #2b69aa 0%,
        #9fc5e5 48%,
        #ffdba2 78%,
        #477b9d 100%
      );
  }

  .showroom-bg .showroom-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .page {
    position: relative;
    z-index: 1;
    perspective: 900px;
    isolation: isolate;
    --blend-overlap: clamp(24rem, 100vh, 68rem);
    /* セクション間に余白を多めに取り、重力遷移が専用の長い
       スクロール区間をしっかり確保できるようにする。 */
    --section-gap: clamp(28rem, 130vh, 72rem);
    --meaning-rise: 3.5rem;
  }

  .page > section {
    transform-style: preserve-3d;
  }

  [data-transition-from],
  [data-transition-to] {
    position: relative;
    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }

  .meaning__inner,
  .meaning__label,
  .meaning__lead,
  .meaning__body,
  .issue__inner,
  .issue__label,
  .issue__lead,
  .issue__body {
    will-change: transform, opacity, filter, text-shadow;
  }

  [data-transition-from] {
    z-index: 2;
    /* セクション自身のコンテンツをマスク下端のフェード域より上に保つ。
       そうしないと半透明で描画され（= 暗く）見えてしまう。 */
    padding-bottom: var(--blend-overlap);
    margin-bottom: calc(var(--blend-overlap) * -1);
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 calc(100% - var(--blend-overlap) * 1.05),
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 calc(100% - var(--blend-overlap) * 1.05),
      transparent 100%
    );
  }

  [data-transition-to] {
    z-index: 3;
    padding-top: calc(var(--blend-overlap) + var(--section-gap));
    transform: translate3d(0, var(--meaning-rise), 0);
    opacity: 1;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 calc(var(--blend-overlap) * 1.08),
      #000 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 calc(var(--blend-overlap) * 1.08),
      #000 100%
    );
  }

  [data-transition-from][data-transition-to] {
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 calc(var(--blend-overlap) * 0.82),
      #000 calc(100% - var(--blend-overlap) * 0.82),
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 calc(var(--blend-overlap) * 0.82),
      #000 calc(100% - var(--blend-overlap) * 0.82),
      transparent 100%
    );
  }

  .meaning[data-transition-from],
  .meaning[data-transition-to],
  .issue[data-transition-from],
  .issue[data-transition-to] {
    -webkit-mask-image: none;
    mask-image: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-transition-from],
    [data-transition-to] {
      transform: none;
      opacity: 1;
      filter: none;
      -webkit-mask-image: none;
      mask-image: none;
    }

    [data-transition-from] {
      margin-bottom: 0;
      padding-bottom: 0;
    }

    [data-transition-to] {
      padding-top: 0;
    }
  }
</style>

<script>
  import { initMusic } from '../scripts/music';
  import { initFunkyReveal } from '../scripts/funkyReveal';
  import { initScatterGlitch } from '../scripts/scatterGlitch';
  import { initReveals } from '../scripts/reveal';
  import { initGravityTransitions } from '../scripts/gravityTransitions';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  initScatterGlitch(reduced);
  initFunkyReveal(reduced);
  initMusic();
  initReveals(reduced);
  initGravityTransitions(reduced);
</script>
