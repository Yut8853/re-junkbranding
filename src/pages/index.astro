---
import Base from '../layouts/Base.astro';
import ShowroomCanvas from '../scenes/showroom/ShowroomCanvas';
import Hero from '../components/Hero.astro';
import Meaning from '../components/Meaning.astro';
import Issue from '../components/Issue.astro';
---

<Base>
  <!-- The Digital Showroom: one persistent 3D space behind the whole page. -->
  <div class="showroom-bg" aria-hidden="true">
    <ShowroomCanvas client:load />
  </div>

  <main class="page">
    <Hero />
    <div class="scene-transition" data-section-transition="hero-meaning" aria-hidden="true">
      <div class="scene-transition__field"></div>
      <div class="scene-transition__axis"></div>
    </div>
    <Meaning />
    <div class="scene-transition" data-section-transition="meaning-issue" aria-hidden="true">
      <div class="scene-transition__field"></div>
      <div class="scene-transition__axis"></div>
    </div>
    <Issue />
  </main>
</Base>

<style is:global>
  .showroom-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .showroom-bg .showroom-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .page {
    position: relative;
    z-index: 1;
    perspective: 900px;
  }

  .page > section {
    transform-style: preserve-3d;
  }

  .scene-transition {
    position: relative;
    height: clamp(26rem, 86vh, 58rem);
    margin-block: min(-14vh, -3.5rem);
    pointer-events: none;
    z-index: 2;
  }

  .scene-transition__field,
  .scene-transition__axis {
    position: sticky;
    top: 0;
    height: 100svh;
    opacity: 0;
    transform-origin: 50% 50%;
    will-change: opacity, transform, filter;
  }

  .scene-transition__field {
    background:
      radial-gradient(
        40% 78% at 50% 50%,
        rgba(127, 159, 194, 0.46) 0%,
        rgba(80, 111, 140, 0.34) 18%,
        rgba(4, 5, 8, 0.82) 46%,
        rgba(4, 5, 8, 0) 100%
      ),
      linear-gradient(
        180deg,
        rgba(4, 5, 8, 0) 0%,
        rgba(4, 5, 8, 0.9) 48%,
        rgba(4, 5, 8, 0) 100%
      );
    filter: blur(3px);
  }

  .scene-transition__axis {
    margin-top: -100svh;
    background:
      linear-gradient(
        180deg,
        rgba(127, 159, 194, 0) 0%,
        rgba(127, 159, 194, 0.38) 40%,
        rgba(255, 214, 160, 0.36) 50%,
        rgba(127, 159, 194, 0.38) 60%,
        rgba(127, 159, 194, 0) 100%
      );
    clip-path: inset(0 44%);
    filter: blur(18px);
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-transition {
      height: 12vh;
      margin-block: 0;
    }

    .scene-transition__field,
    .scene-transition__axis {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const transitions = document.querySelectorAll<HTMLElement>('[data-section-transition]');

  if (reduced) {
    els.forEach((el) => {
      el.style.opacity = '1';
      el.style.transform = 'none';
    });
  } else {
    gsap.registerPlugin(ScrollTrigger);
    els.forEach((el) => {
      const delay = Number(el.dataset.revealDelay ?? 0);
      gsap.fromTo(
        el,
        { autoAlpha: 0, y: 28 },
        {
          autoAlpha: 1,
          y: 0,
          duration: 1.1,
          delay,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 82%',
            once: true,
          },
        },
      );
    });

    transitions.forEach((transition) => {
      const prev = transition.previousElementSibling as HTMLElement | null;
      const next = transition.nextElementSibling as HTMLElement | null;
      const prevContent = prev?.querySelector<HTMLElement>(':scope > :not([aria-hidden="true"])');
      const nextContent = next?.querySelector<HTMLElement>(':scope > :not([aria-hidden="true"])');
      const field = transition.querySelector<HTMLElement>('.scene-transition__field');
      const axis = transition.querySelector<HTMLElement>('.scene-transition__axis');

      if (!prevContent || !nextContent || !field || !axis) return;

      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: transition,
          start: 'top bottom',
          end: 'bottom top',
          scrub: true,
        },
      });

      tl.fromTo(
        field,
        { autoAlpha: 0, scaleY: 0.08, scaleX: 1.26, filter: 'blur(0px)' },
        { autoAlpha: 1, scaleY: 2.75, scaleX: 0.84, filter: 'blur(5px)', duration: 0.42 },
        0,
      )
        .to(field, { autoAlpha: 0.88, scaleY: 3.4, scaleX: 0.78, filter: 'blur(11px)', duration: 0.2 }, 0.42)
        .to(field, { autoAlpha: 0, scaleY: 0.62, scaleX: 1.22, filter: 'blur(18px)', duration: 0.34 }, 0.66)
        .fromTo(
          axis,
          { autoAlpha: 0, scaleY: 0.04, scaleX: 2.0 },
          { autoAlpha: 1, scaleY: 5.4, scaleX: 0.72, duration: 0.44 },
          0.02,
        )
        .to(axis, { autoAlpha: 0.75, scaleY: 6.2, scaleX: 0.56, duration: 0.18 }, 0.44)
        .to(axis, { autoAlpha: 0, scaleY: 0.5, scaleX: 2.2, duration: 0.36 }, 0.64)
        .fromTo(
          prevContent,
          { autoAlpha: 1, y: 0, z: 0, scale: 1, filter: 'blur(0px)' },
          { autoAlpha: 0.22, y: -112, z: 220, scaleY: 1.3, scaleX: 0.94, filter: 'blur(8px)', duration: 0.56 },
          0,
        )
        .fromTo(
          nextContent,
          { autoAlpha: 0.18, y: 132, z: -220, scaleY: 0.68, scaleX: 1.08, filter: 'blur(9px)' },
          { autoAlpha: 1, y: 0, z: 0, scaleY: 1, scaleX: 1, filter: 'blur(0px)', duration: 0.56 },
          0.5,
        );
    });
  }
</script>
