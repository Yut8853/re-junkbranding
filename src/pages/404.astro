---
import Base from '../layouts/Base.astro';
import SiteLogo from '../components/SiteLogo.astro';

const title = '404｜JUNKBRANDING';
const description = 'お探しのページは見つかりませんでした。5秒後にトップページへ移動します。';
---

<Base title={title} description={description}>
  <header>
    <SiteLogo />
  </header>

  <main id="main" class="not-found" tabindex="-1">
    <canvas class="not-found__canvas" aria-hidden="true"></canvas>

    <section class="not-found__content" aria-labelledby="not-found-title">
      <p class="not-found__label">NOT FOUND</p>
      <h1 id="not-found-title" class="sr-only">404 ページが見つかりません</h1>
      <p class="not-found__timer" aria-live="polite">
        <span class="not-found__count">5</span>秒後にトップページへ移動します
      </p>
      <a class="not-found__link" href="/">トップページへ</a>
    </section>
  </main>
</Base>

<style>
  .not-found {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: clamp(5.5rem, 11vh, 8rem) var(--gutter) clamp(3rem, 8vh, 5rem);
    overflow: hidden;
    isolation: isolate;
    letter-spacing: 0;
    background:
      radial-gradient(circle at 50% 44%, rgba(244, 220, 187, 0.22), transparent 36%),
      radial-gradient(circle at 20% 85%, rgba(114, 206, 232, 0.2), transparent 30%),
      linear-gradient(180deg, #15395d 0%, #24507e 48%, #132c49 100%);
  }

  .not-found::before {
    content: "";
    position: absolute;
    inset: auto -8% -18% -8%;
    height: 42vh;
    background: linear-gradient(180deg, transparent, rgba(255, 219, 162, 0.22));
    transform: skewY(-3deg);
    pointer-events: none;
    z-index: -1;
  }

  .not-found__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .not-found__content {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: clamp(0.7rem, 1.8vw, 1rem);
    width: min(100%, 46rem);
    padding-top: clamp(20rem, 46vh, 30rem);
    text-align: center;
    text-shadow: 0 0 24px rgba(8, 19, 34, 0.46);
  }

  .not-found__label {
    color: rgba(244, 220, 187, 0.9);
    font-size: clamp(0.72rem, 1.8vw, 0.86rem);
    font-weight: 700;
    letter-spacing: 0;
  }

  .not-found__message {
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--font-serif);
    font-size: clamp(1rem, 2.6vw, 1.35rem);
    line-height: 1.9;
  }

  .not-found__timer {
    color: rgba(255, 255, 255, 0.74);
    font-size: clamp(0.86rem, 2vw, 0.98rem);
    line-height: 1.7;
  }

  .not-found__count {
    display: inline-grid;
    place-items: center;
    min-width: 1.5em;
    margin-inline-end: 0.18em;
    color: #fff;
    font-weight: 800;
  }

  .not-found__link {
    display: inline-grid;
    place-items: center;
    min-height: 2.85rem;
    margin-top: 0.35rem;
    padding: 0.55rem 1.35rem;
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: 999px;
    background: rgba(7, 18, 32, 0.28);
    color: #fff;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    backdrop-filter: blur(12px);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .not-found__link:hover {
    transform: translateY(-2px);
    border-color: rgba(244, 220, 187, 0.72);
    background: rgba(244, 220, 187, 0.14);
  }

  @media (max-width: 640px) {
    .not-found__content {
      padding-top: clamp(16.5rem, 43vh, 22rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__link {
      transition: none;
    }
  }
</style>

<script>
  import * as THREE from 'three';

  const canvas = document.querySelector<HTMLCanvasElement>('.not-found__canvas');
  const count = document.querySelector<HTMLElement>('.not-found__count');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas) {
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(0, 1, 1, 0, -10, 10);
    const clock = new THREE.Clock();
    const pointer = new THREE.Vector2(0, 0);
    const pointerTarget = new THREE.Vector2(0, 0);
    const uniforms = {
      uTime: { value: 0 },
      uSettle: { value: reduced ? 1 : 0 },
      uPixelRatio: { value: 1 },
      uPointer: { value: pointer },
      uReduced: { value: reduced ? 1 : 0 },
    };
    const material = new THREE.ShaderMaterial({
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      uniforms,
      vertexShader: `
        attribute vec2 aTarget;
        attribute vec2 aStart;
        attribute float aSize;
        attribute float aPhase;
        attribute float aWarmth;

        uniform float uTime;
        uniform float uSettle;
        uniform float uPixelRatio;
        uniform vec2 uPointer;
        uniform float uReduced;

        varying float vGlow;
        varying float vWarmth;

        float easeOutCubic(float value) {
          return 1.0 - pow(1.0 - value, 3.0);
        }

        void main() {
          float settle = easeOutCubic(clamp(uSettle, 0.0, 1.0));
          vec2 position2d = mix(aStart, aTarget, settle);
          float motion = 1.0 - uReduced;
          float drift = sin(uTime * 0.9 + aPhase) * 0.006 * motion;
          float breath = cos(uTime * 0.72 + aPhase * 1.37) * 0.004 * motion;
          vec2 pointerPull = uPointer * 0.018 * sin(aPhase + uTime * 0.45) * motion;

          position2d += vec2(drift, breath) + pointerPull;
          gl_Position = vec4(position2d * 2.0 - 1.0, 0.0, 1.0);
          gl_PointSize = (aSize + sin(uTime * 1.35 + aPhase) * 0.75 * motion) * uPixelRatio;
          vGlow = 0.58 + sin(uTime * 1.7 + aPhase) * 0.22;
          vWarmth = aWarmth;
        }
      `,
      fragmentShader: `
        precision mediump float;

        varying float vGlow;
        varying float vWarmth;

        void main() {
          vec2 point = gl_PointCoord - 0.5;
          float distanceFromCenter = length(point);
          float core = smoothstep(0.5, 0.08, distanceFromCenter);
          float halo = smoothstep(0.5, 0.0, distanceFromCenter) * 0.48;
          vec3 cool = vec3(0.58, 0.84, 1.0);
          vec3 warm = vec3(1.0, 0.83, 0.48);
          vec3 color = mix(cool, warm, vWarmth);
          float alpha = (core + halo) * (0.5 + vGlow * 0.55);

          gl_FragColor = vec4(color, alpha);
        }
      `,
    });
    let geometry = new THREE.BufferGeometry();
    const points = new THREE.Points(geometry, material);
    scene.add(points);
    let width = 0;
    let height = 0;
    let animationFrame = 0;

    const shuffle = <T,>(items: T[]) => {
      for (let index = items.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1));
        [items[index], items[swapIndex]] = [items[swapIndex], items[index]];
      }
      return items;
    };

    const buildTargets = () => {
      const sampleCanvas = document.createElement('canvas');
      const sampleContext = sampleCanvas.getContext('2d');
      if (!sampleContext) return [];

      sampleCanvas.width = Math.max(320, Math.floor(width));
      sampleCanvas.height = Math.max(260, Math.floor(height));

      const fontSize = Math.min(width * 0.54, height * 0.42, 360);
      sampleContext.clearRect(0, 0, sampleCanvas.width, sampleCanvas.height);
      sampleContext.fillStyle = '#fff';
      sampleContext.textAlign = 'center';
      sampleContext.textBaseline = 'middle';
      sampleContext.font = `900 ${fontSize}px ${getComputedStyle(document.body).fontFamily}`;
      sampleContext.fillText('404', sampleCanvas.width / 2, sampleCanvas.height * 0.38);

      const imageData = sampleContext.getImageData(0, 0, sampleCanvas.width, sampleCanvas.height).data;
      const step = Math.max(4, Math.floor(Math.min(width, height) / 150));
      const targets: Array<{ x: number; y: number }> = [];

      for (let y = 0; y < sampleCanvas.height; y += step) {
        for (let x = 0; x < sampleCanvas.width; x += step) {
          const alpha = imageData[(y * sampleCanvas.width + x) * 4 + 3];
          if (alpha > 32) {
            targets.push({ x, y });
          }
        }
      }

      return shuffle(targets).slice(0, Math.min(3600, Math.max(1400, targets.length)));
    };

    const rebuildParticles = () => {
      if (width <= 0 || height <= 0) return;

      const targets = buildTargets();
      const positions = new Float32Array(targets.length * 3);
      const targetPositions = new Float32Array(targets.length * 2);
      const startPositions = new Float32Array(targets.length * 2);
      const sizes = new Float32Array(targets.length);
      const phases = new Float32Array(targets.length);
      const warmth = new Float32Array(targets.length);

      targets.forEach((target, index) => {
        const offset = index * 2;
        const positionOffset = index * 3;
        targetPositions[offset] = target.x / width;
        targetPositions[offset + 1] = 1 - target.y / height;
        startPositions[offset] = Math.random();
        startPositions[offset + 1] = -0.18 - Math.random() * 0.24;
        positions[positionOffset] = targetPositions[offset] * 2 - 1;
        positions[positionOffset + 1] = targetPositions[offset + 1] * 2 - 1;
        positions[positionOffset + 2] = 0;
        sizes[index] = 2.2 + Math.random() * 4.6;
        phases[index] = Math.random() * Math.PI * 2;
        warmth[index] = Math.random();
      });

      geometry.dispose();
      geometry = new THREE.BufferGeometry();
      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      geometry.setAttribute('aTarget', new THREE.BufferAttribute(targetPositions, 2));
      geometry.setAttribute('aStart', new THREE.BufferAttribute(startPositions, 2));
      geometry.setAttribute('aSize', new THREE.BufferAttribute(sizes, 1));
      geometry.setAttribute('aPhase', new THREE.BufferAttribute(phases, 1));
      geometry.setAttribute('aWarmth', new THREE.BufferAttribute(warmth, 1));
      points.geometry = geometry;
      clock.start();
      uniforms.uSettle.value = reduced ? 1 : 0;
    };

    const resize = () => {
      const bounds = canvas.getBoundingClientRect();
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      width = Math.max(1, bounds.width || canvas.clientWidth || window.innerWidth);
      height = Math.max(1, bounds.height || canvas.clientHeight || window.innerHeight);
      renderer.setPixelRatio(pixelRatio);
      renderer.setSize(width, height, false);
      uniforms.uPixelRatio.value = pixelRatio;
      rebuildParticles();
    };

    const render = () => {
      const elapsed = clock.getElapsedTime();
      pointer.lerp(pointerTarget, 0.075);
      uniforms.uTime.value = elapsed;
      uniforms.uSettle.value = reduced ? 1 : Math.min(1, elapsed / 1.4);
      renderer.render(scene, camera);
      animationFrame = requestAnimationFrame(render);
    };

    const handlePointer = (event: PointerEvent) => {
      pointerTarget.set(
        (event.clientX / window.innerWidth) * 2 - 1,
        -((event.clientY / window.innerHeight) * 2 - 1),
      );
    };

    const dispose = () => {
      cancelAnimationFrame(animationFrame);
      window.removeEventListener('resize', resize);
      window.removeEventListener('pointermove', handlePointer);
      geometry.dispose();
      material.dispose();
      renderer.dispose();
    };

    resize();
    window.addEventListener('resize', resize, { passive: true });
    window.addEventListener('pointermove', handlePointer, { passive: true });
    animationFrame = requestAnimationFrame(render);
    window.addEventListener('pagehide', dispose, { once: true });
  }

  const redirectAt = Date.now() + 5000;
  const updateCount = () => {
    const remaining = Math.max(0, Math.ceil((redirectAt - Date.now()) / 1000));
    if (count) count.textContent = String(remaining);
  };

  updateCount();
  const interval = window.setInterval(updateCount, 250);

  window.setTimeout(() => {
    window.clearInterval(interval);
    window.location.assign('/');
  }, 5000);
</script>