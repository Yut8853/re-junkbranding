---
/** 左上に固定表示するワードマーク。背後の WebGL シーンに馴染ませる。 */
---

<div class="site-brand" data-music-autostart-ignore>
  <a class="site-logo" href="/" aria-label="JUNK BRANDING トップへ">
    <span class="site-logo__main">JUNKBRANDING</span>
  </a>

  <button class="funky-version" type="button" aria-label="Funky Version" aria-controls="funky-reveal" data-funky-version>
    <span class="funky-version__text funky-version__text--default">Funky Version</span>
    <span class="funky-version__text funky-version__text--hover" aria-hidden="true">Are you bored?</span>
  </button>
</div>

<style>
  .site-brand {
    position: fixed;
    top: max(1.1rem, env(safe-area-inset-top));
    left: max(1.4rem, env(safe-area-inset-left));
    z-index: 20;
    display: grid;
    justify-items: start;
    gap: 0.62rem;
  }

  .site-logo {
    display: flex;
    align-items: baseline;
    gap: 0.55em;
    font-family: var(--font-serif);
    text-decoration: none;
    color: var(--ink);
    mix-blend-mode: difference;
    transition: opacity 0.28s ease;
  }

  .funky-version {
    position: relative;
    display: grid;
    place-items: center;
    width: min(8.8rem, calc(100vw - 2rem));
    height: 2.15rem;
    padding: 0 0.85rem;
    overflow: hidden;
    border: 1px solid rgba(225, 238, 255, 0.18);
    border-radius: 999px;
    color: rgba(235, 242, 255, 0.78);
    background:
      radial-gradient(circle at 50% 30%, rgba(235, 244, 255, 0.14), transparent 62%),
      rgba(36, 80, 126, 0.5);
    box-shadow:
      0 0.8rem 2rem rgba(35, 83, 128, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(18px) saturate(130%);
    -webkit-backdrop-filter: blur(18px) saturate(130%);
    cursor: pointer;
    font: inherit;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    transition:
      color 0.28s ease,
      border-color 0.28s ease,
      background 0.28s ease,
      transform 0.28s ease,
      box-shadow 0.28s ease;
  }

  .funky-version:hover {
    transform: translateY(-2px);
    border-color: rgba(220, 236, 255, 0.34);
    color: #eef6ff;
  }

  .funky-version:focus-visible {
    outline: 2px solid rgba(210, 232, 255, 0.76);
    outline-offset: 4px;
  }

  .funky-version__text {
    grid-area: 1 / 1;
    white-space: nowrap;
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
  }

  .funky-version__text--hover {
    opacity: 0;
    transform: translateY(0.55rem);
  }

  .funky-version:hover .funky-version__text--default,
  .funky-version:focus-visible .funky-version__text--default {
    opacity: 0;
    transform: translateY(-0.55rem);
  }

  .funky-version:hover .funky-version__text--hover,
  .funky-version:focus-visible .funky-version__text--hover {
    opacity: 1;
    transform: translateY(0);
  }

  .site-logo:hover {
    opacity: 0.72;
  }

  .site-logo:focus-visible {
    outline: 2px solid rgba(210, 232, 255, 0.76);
    outline-offset: 6px;
  }

  .site-logo__main {
    font-size: 1.18rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    line-height: 1;
  }

  .site-logo__sub {
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.42em;
    line-height: 1;
    color: var(--warm);
    opacity: 0.85;
  }
</style>
