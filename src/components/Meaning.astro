<style lang="scss">
  .meaning {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  .meaning__inner {
    position: relative;
    z-index: 1;
    max-width: none;
    padding-inline: var(--gutter);
  }

  .meaning__label {
    margin: 0 0 1.8rem;
    font-size: 0.74rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--warm);
    opacity: 0.8;
  }

  .meaning__lead {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.4rem, 3.4vw, 2.6rem);
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: #fff;
    white-space: nowrap;
  }

  .meaning__body {
    margin-top: 1.8rem;
    font-size: clamp(0.92rem, 1.5vw, 1.2rem);
    line-height: 2.1;
    color: var(--ink-dim);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .meaning__lead,
    .meaning__body {
      white-space: normal;
