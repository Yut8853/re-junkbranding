---
---

<section class="hero" data-hero data-transition-from="hero">
  <!-- 左側のスクリム: 3D ショールームの上でもコピーが完全に読めるようにする。 -->
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__inner">
    <p class="hero__eyebrow">Experience-driven Web Design</p>

    <h1 class="hero__title">
      眺めるWebから、<br />
      入り込むWebへ。
    </h1>

    <p class="hero__lead">
      世界観まで伝わる、<br />
      体験型Webサイトを制作します。
    </p>

    <div class="hero__scroll" aria-hidden="true">
      <span class="hero__scroll-text">Scroll</span>
      <span class="hero__scroll-line"></span>
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    min-height: calc(100svh + var(--blend-overlap));
    display: flex;
    align-items: center;
    /* KV を（重なり込みで高くなったボックスではなく）実際に見えている
       ビューポートの中央に置き、さらに少し上へ持ち上げる。 */
    padding-bottom: calc(var(--blend-overlap) + 14svh);
    overflow: hidden;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;

  }

  .hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--gutter);
    text-align: center;
    transform-origin: 50% 66%;
    will-change: transform, opacity, filter;
  }

  .hero__eyebrow {
    margin: 0 0 1.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--warm);
    opacity: 0.85;
    will-change: transform, opacity, filter;
  }

  .hero__title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(2.4rem, 6.6vw, 4.6rem);
    line-height: 1.32;
    letter-spacing: 0.02em;
    color: #fff;
    text-shadow: 0 1px 40px rgba(6, 7, 11, 0.6);
    will-change: transform, opacity, filter, text-shadow;
  }

  .hero__lead {
    margin-top: 2rem;
    margin-inline: auto;
    font-size: clamp(1rem, 1.9vw, 1.3rem);
    line-height: 2;
    color: var(--ink-dim);
    text-shadow: 0 1px 18px rgba(20, 45, 80, 0.55);
    max-width: 34ch;
    will-change: transform, opacity, filter, text-shadow;
  }

  .hero__scroll {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(3rem, 8vh, 5rem);
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-shadow: 0 1px 14px rgba(20, 45, 80, 0.5);
    will-change: transform, opacity, filter;
  }

  .hero__scroll-text {
    writing-mode: vertical-rl;
    letter-spacing: 0.32em;
  }

  .hero__scroll-line {
    position: relative;
    display: block;
    width: 1px;
    height: 3.4rem;
    overflow: hidden;
    background: rgba(174, 189, 210, 0.22);
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent, var(--ink-faint));
    animation: heroScrollLine 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes heroScrollLine {
    0% {
      transform: translateY(-100%);
    }
    55% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line::after {
      animation: none;
    }
  }

  @media (max-width: 720px) {
    .hero__scrim {
      background:
        linear-gradient(
          to top,
          rgba(6, 7, 11, 0.94) 8%,
          rgba(6, 7, 11, 0.55) 48%,
          rgba(6, 7, 11, 0.2) 100%
        );
    }

    .hero__lead {
      max-width: none;
    }
  }
</style>
