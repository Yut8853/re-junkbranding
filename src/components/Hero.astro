---
---

<section class="hero" data-hero data-transition-from="hero">
  <!-- Left scrim keeps the copy fully readable over the 3D showroom. -->
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__inner">
    <p class="hero__eyebrow">Experience-driven Web Design</p>

    <h1 class="hero__title">
      眺めるWebから、<br />
      入り込むWebへ。
    </h1>

    <p class="hero__lead">
      世界観まで伝わる、<br />
      体験型Webサイトを制作します。
    </p>

    <div class="hero__scroll" aria-hidden="true">
      <span class="hero__scroll-line"></span>
      Scroll
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    min-height: calc(100svh + var(--blend-overlap));
    display: flex;
    align-items: center;
    /* Keep the KV centred in the visible viewport (not the taller
       overlap box) and lift it further up. */
    padding-bottom: calc(var(--blend-overlap) + 14svh);
    overflow: hidden;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        100deg,
        rgba(5, 6, 10, 0.9) 0%,
        rgba(5, 6, 10, 0.62) 26%,
        rgba(5, 6, 10, 0.16) 52%,
        rgba(5, 6, 10, 0) 78%
      ),
      linear-gradient(
        to top,
        rgba(232, 238, 248, 0.18) 0%,
        rgba(245, 248, 255, 0.08) 22%,
        rgba(5, 6, 10, 0) 52%
      );
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--gutter);
    text-align: center;
    transform-origin: 50% 66%;
    will-change: transform, opacity, filter;
  }

  .hero__eyebrow {
    margin: 0 0 1.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--warm);
    opacity: 0.85;
    will-change: transform, opacity, filter;
  }

  .hero__title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(2.4rem, 6.6vw, 4.6rem);
    line-height: 1.32;
    letter-spacing: 0.02em;
    color: #fff;
    text-shadow: 0 1px 40px rgba(6, 7, 11, 0.6);
    will-change: transform, opacity, filter, text-shadow;
  }

  .hero__lead {
    margin-top: 2rem;
    margin-inline: auto;
    font-size: clamp(1rem, 1.9vw, 1.3rem);
    line-height: 2;
    color: var(--ink-dim);
    max-width: 34ch;
    will-change: transform, opacity, filter, text-shadow;
  }

  .hero__scroll {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    margin-top: clamp(3rem, 8vh, 5rem);
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ink-faint);
    will-change: transform, opacity, filter;
  }

  .hero__scroll-line {
    display: block;
    width: 3.2rem;
    height: 1px;
    background: linear-gradient(90deg, var(--ink-faint), transparent);
    transform-origin: left center;
    animation: heroScrollLine 2.6s ease-in-out infinite;
  }

  @keyframes heroScrollLine {
    0%,
    100% {
      transform: scaleX(0.4);
      opacity: 0.4;
    }
    50% {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line {
      animation: none;
    }
  }

  @media (max-width: 720px) {
    .hero__scrim {
      background:
        linear-gradient(
          to top,
          rgba(6, 7, 11, 0.94) 8%,
          rgba(6, 7, 11, 0.55) 48%,
          rgba(6, 7, 11, 0.2) 100%
        );
    }

    .hero__lead {
      max-width: none;
    }
  }
</style>
