---

<section class="section services" data-gravity-bottom-only aria-labelledby="services-title">
  <div class="services__inner">
    <header class="services__head" data-reveal>
      <p class="services__label">Service Index</p>
      <h2 class="services__title" id="services-title">できること</h2>
    </header>

    <div class="services__grid">
      {serviceGroups.map((group, index) => (
        <section
          class="services__group"
          aria-labelledby={`services-group-${index}`}
          data-reveal
          data-reveal-delay={String(index * 0.035)}
        >
          <div class="services__group-title">
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3 id={`services-group-${index}`}>{group.title}</h3>
          </div>
          <ul class="services__list">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  .services {
    position: relative;
    min-height: 100svh;
    padding-block: clamp(9rem, 18vh, 14rem);
    padding-inline: var(--gutter);
  }

  .services__inner {
    position: relative;
    z-index: 1;
    width: min(100%, 1320px);
    margin-inline: auto;
  }

  .services__head {
    display: grid;
    grid-template-columns: minmax(10rem, 0.34fr) 1fr;
    gap: clamp(1.25rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 7vw, 5.5rem);
    border-bottom: 1px solid rgba(226, 238, 255, 0.18);
    padding-bottom: clamp(1.4rem, 3vw, 2.2rem);
  }

  .services__label {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: rgba(188, 239, 255, 0.72);
  }

  .services__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 4vw, 3.65rem);
    font-weight: 600;
    line-height: 1.28;
    letter-spacing: 0.02em;
    color: #fff;
    text-align: right;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 5vw, 5rem);
    row-gap: 0;
  }

  .services__group {
    display: grid;
    grid-template-columns: minmax(9rem, 0.34fr) 1fr;
    gap: clamp(1rem, 2.6vw, 2.2rem);
    border-top: 1px solid rgba(226, 238, 255, 0.14);
    padding-block: clamp(1.1rem, 2.4vw, 1.8rem);
  }

  .services__group-title {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
    min-width: 0;
  }

  .services__group-title span {
    flex: 0 0 auto;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: rgba(188, 239, 255, 0.6);
  }

  .services__group-title h3 {
    margin: 0;
    font-size: clamp(0.82rem, 1.1vw, 1rem);
    font-weight: 600;
    line-height: 1.55;
    color: rgba(248, 251, 255, 0.94);
  }

  .services__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.46rem 0.9rem;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .services__list li {
    position: relative;
    padding-left: 0.75rem;
    font-size: clamp(0.78rem, 0.96vw, 0.92rem);
    line-height: 1.7;
    color: white;
    white-space: nowrap;
  }

  .services__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.78em;
    width: 0.28rem;
    height: 1px;
    background: rgba(188, 239, 255, 0.56);
  }

  @media (max-width: 980px) {
    .services__head,
    .services__grid,
    .services__group {
      grid-template-columns: 1fr;
    }

    .services__title {
      text-align: left;
    }
  }

  @media (max-width: 640px) {
    .services {
      padding-block: 7rem;
    }

    .services__list li {
      white-space: normal;
    }
  }
</style>
